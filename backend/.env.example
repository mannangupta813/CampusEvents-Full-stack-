# ==========================================================
# Campus Events Backend: Environment Variables Example
# Copy to .env or configure in your cloud host (e.g. Render / Railway)
# ==========================================================

PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_events?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password
JWT_SECRET=CampusEventsSuperSecretKeyForJWTSigning2026CollegiatePlatformSecurityKeyShouldBeLongEnough256Bits
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://campus-events.vercel.app

